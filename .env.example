# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://contextbridge:contextbridge@localhost:5432/contextbridge
APP_URL=http://localhost:3000
# 32+ chars. Signs session cookies and encrypts stored integration credentials.
SESSION_SECRET=replace-me-with-a-long-random-string-min-32-chars
CREDENTIAL_SECRET=replace-me-with-a-different-long-random-string-32

# ---------------------------------------------------------------------------
# Embeddings — provider abstraction. `local` is deterministic and needs no key,
# which keeps dev, CI and tests runnable offline.
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=local            # local | voyage | openai
VOYAGE_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Answer generation (Anthropic). Without a key the app degrades to
# retrieval-only: it returns ranked sources but no synthesised answer.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ---------------------------------------------------------------------------
# Integrations (all optional — each unlocks one connector)
# ---------------------------------------------------------------------------
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=1000
LOG_LEVEL=info
